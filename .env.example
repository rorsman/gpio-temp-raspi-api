# Optional with a single sensor. Required if multiple DS18B20 devices are attached.
SENSOR_ID=

# Host HTTP port; the container listens on 8080.
API_PORT=8080

# Tag of the prebuilt image; deploy-to-pi.sh generates a unique tag by default.
IMAGE_TAG=latest

# Delay after a sensor read completes; freshness limit for the last valid sample.
SENSOR_SAMPLE_DELAY_MS=1000
SENSOR_MAX_AGE=5s
